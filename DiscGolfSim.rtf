def getNewThrow():\par
    handed = input("What hand will you throw with?:\\n1. right\\n2. left\\n")\par
    swing = input("\\n1. Forehand\\n2. backhand\\n")\par
    \par
    disc = input("\\nWhat disc do you want to throw?\\n1. Putter\\n2. Mid\\n3. Driver\\n")\par
    stability = input("\\n1. Overstable\\n2. Straight\\n3. Understable\\n")\par
    angle = input("\\nWhat type of throw?\\n1. Hyzer\\n2. Flat\\n3. Anhyzer\\n")\par
    force = int(input("\\nHow hard will you throw? 1-10\\n"))\par
    direction = input("\\nWhat direction? \\nEnter numpad number for direction\\n")\par
    fade = 0\par
    turn = 0\par
    return Throw(fade,turn,handed,swing,disc,stability,angle,force,direction)\par
