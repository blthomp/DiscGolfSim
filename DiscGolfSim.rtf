    def showThrow(self,hole):\par
        # While disc still moving and not in basket\par
        while self.force > 0 and hole.map[hole.discLoc[0]][hole.discLoc[1]] != "B":\par
            os.system('cls' if os.name == 'nt' else 'clear')\par
            self.lastRow=hole.discLoc[0]\par
            self.lastCol=hole.discLoc[1]\par
            hole.deleteDisc()\par
            self.moveDisc()\par
        ## hit tree\par
            if hole.map[hole.discLoc[0]][hole.discLoc[1]] == "T":\par
                self.hit=True\par
                self.force-=2\par
                print("Whack! You hit a tree.")\par
                hole.printMap()\par
                time.sleep(1)\par
                os.system('cls' if os.name == 'nt' else 'clear')\par
        ## out of bounds\par
            elif hole.map[hole.discLoc[0]][hole.discLoc[1]] == "|" or hole.map[hole.discLoc[0]][hole.discLoc[1]] == "_":\par
                hole.score+=1\par
                self.force = 0\par
                hole.discLoc[0]=self.lastRow\par
                hole.discLoc[1]=self.lastCol\par
        ## make basket\par
            elif hole.map[hole.discLoc[0]][hole.discLoc[1]] == "B":\par
                break\par
            hole.updateMap()\par
            hole.printMap()\par
            time.sleep(.25)\par
