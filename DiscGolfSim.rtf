def makeMap(height,width):\par
    map=[]\par
    map.append(list(" "+("_"*width)))\par
    for j in range(height):\par
        map.append(list("|"+(" "*width)+"|"))\par
    map.append(list("|"+("_"*width)+"|"))\par
    return map\par
