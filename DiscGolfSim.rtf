class Throw:\par
    def __init__(self,FADE,TURN,HANDED,SWING,DISC,STABILITY,ANGLE,FORCE,DIRECTION):\par
        self.fade=FADE\par
        self.turn=TURN\par
        self.handed=HANDED\par
        self.swing=SWING\par
        self.disc=DISC\par
        self.stability=STABILITY\par
        self.angle=ANGLE\par
        self.force=FORCE\par
        self.direction=DIRECTION\par
        self.lastRow = 19\par
        self.lastCol = 20\par
        self.hit = False\par
        self.turnSpeed = FORCE/2\par
        if DISC == "1":\par
            self.fadeSpeed = 1\par
        elif DISC == "2":\par
            self.fadeSpeed = 2\par
        else:\par
            self.fadeSpeed = 3\par
        \par
    def updateValues(self):\par
        if self.handed=="1":\par
            self.handed=1\par
        else:\par
            self.handed=-1\par
        if self.swing == "2":\par
            self.swing=-1\par
        else:\par
            self.swing=1\par
        if self.disc == "1":\par
            self.turnSpeed = 9\par
            self.fadeSpeed = 1\par
        elif self.disc == "2":\par
            self.force*=1.3\par
            self.turnSpeed = 7\par
            self.fadeSpeed = 3\par
        elif self.disc == "3":\par
            self.force*=1.5\par
            self.turnSpeed = 7\par
            self.fadeSpeed = 5\par
        if self.stability == "1":\par
            self.fade=(self.handed*self.swing)*2\par
        elif self.stability == "2":\par
            self.fade=(self.handed*self.swing)\par
        elif self.stability == "3":\par
            self.turn=(self.handed*self.swing)*-1\par
            self.fade=(self.handed*self.swing)\par
        if self.angle=="hyzer":\par
            self.turn+=(self.handed*self.swing)\par
            self.fade+=(self.handed*self.swing)\par
        elif self.angle=="anhyzer":\par
            self.turn-=(self.handed*self.swing)\par
    \par
    def moveDisc(self):\par
        if self.direction=="8":\par
            if self.hit==True:\par
                hole.discLoc[0]+=1\par
            else:\par
                hole.discLoc[0]+=-1\par
            if self.force < self.fadeSpeed:\par
                hole.discLoc[1]+=self.fade\par
            elif self.force > self.turnSpeed:\par
                hole.discLoc[1]+=self.turn\par
        elif self.direction=="7":\par
            if self.hit==True:\par
                hole.discLoc[0]+=1\par
                hole.discLoc[1]-=1\par
            else:\par
                hole.discLoc[0]+=-1\par
                hole.discLoc[1]-=1\par
            if self.force < self.fadeSpeed:\par
                hole.discLoc[1]+=self.fade\par
            elif self.force > self.turnSpeed:\par
                hole.discLoc[1]+=self.turn\par
        elif self.direction=="9":\par
            if self.hit==True:\par
                hole.discLoc[0]+=1\par
                hole.discLoc[1]+=1\par
            else:\par
                hole.discLoc[0]+=-1\par
                hole.discLoc[1]+=1\par
            if self.force < self.fadeSpeed:\par
                hole.discLoc[1]+=self.fade\par
            elif self.force > self.turnSpeed:\par
                hole.discLoc[1]+=self.turn\par
        elif self.direction=="4":\par
            if self.hit==True:\par
                hole.discLoc[1]+=1\par
            else:\par
                hole.discLoc[1]+=-1\par
            if self.force < 4:\par
                hole.discLoc[0]+=self.fade\par
            elif self.force > 7:\par
                hole.discLoc[0]+=self.turn\par
        elif self.direction=="6":\par
            if self.hit==True:\par
                hole.discLoc[1]+=-1\par
            else:\par
                hole.discLoc[1]+=1\par
            if self.force < 4:\par
                hole.discLoc[0]+=self.fade\par
            elif self.force > 7:\par
                hole.discLoc[0]+=self.turn\par
        elif self.direction=="1":\par
            if self.hit==True:\par
                hole.discLoc[0]+=-1\par
                hole.discLoc[1]+=-1\par
            else:\par
                hole.discLoc[0]+=1\par
                hole.discLoc[1]+=-1\par
            if self.force < self.fadeSpeed:\par
                hole.discLoc[1]-=self.fade\par
            elif self.force > self.fadeSpeed:\par
                hole.discLoc[1]-=self.turn\par
        elif self.direction=="2":\par
            if self.hit==True:\par
                hole.discLoc[0]+=-1\par
            else:\par
                hole.discLoc[0]+=1\par
            if self.force < self.fadeSpeed:\par
                hole.discLoc[1]-=self.fade\par
            elif self.force > self.fadeSpeed:\par
                hole.discLoc[1]-=self.turn\par
        elif self.direction=="3":\par
            if self.hit==True:\par
                hole.discLoc[0]+=-1\par
                hole.discLoc[1]+=1\par
            else:\par
                hole.discLoc[0]+=1\par
                hole.discLoc[1]+=1\par
            if self.force < self.fadeSpeed:\par
                hole.discLoc[1]-=self.fade\par
            elif self.force > self.fadeSpeed:\par
                hole.discLoc[1]-=self.turn\par
        self.force-=1\par
