class Hole:\par
    def __init__(self,MAP,LENGTH,NAME,TEE,BASKET,TREES):\par
        self.map = MAP\par
        self.length = LENGTH\par
        self.name = NAME\par
        self.tee = TEE\par
        self.basket = BASKET\par
        self.discLoc = TEE\par
        self.trees = TREES\par
        self.score = -3\par
        self.par = 3\par
    \par
    def updateMap(self):\par
        self.map[self.discLoc[0]][self.discLoc[1]] = "o"\par
        self.map[self.basket[0]][self.basket[1]] = "B"\par
        for tree in self.trees:\par
            self.map[tree[0]][tree[1]] = "T"\par
        \par
    def printMap(self):\par
        for x in self.map:\par
            print(*x, sep='')\par
        print(f"\{self.name\}: \{self.length\} feet\\n")\par
    \par
    def deleteDisc(self):\par
        self.map[self.discLoc[0]][self.discLoc[1]] = " "\par
    \par
    def playHole(self):\par
        while self.map[self.discLoc[0]][self.discLoc[1]] != "B":    \par
            print(f"Throws this hole: \{self.score+self.par\}")\par
            self.updateMap()\par
            self.printMap()\par
